#!/usr/bin/env python3
"""heavy-run: queue for a slot, then run a command and kill it if it hangs.

`heavy` execs this. It joins the machine-wide queue in $HEAVY_HOME (see heavyq.py) and
waits for a slot (exit 125 if cancelled from heavy-top; 128+signal on Ctrl-C/TERM/HUP).
Once admitted it runs the command; the watchdog clock starts at admission.

Passes stdio and the exit code through. Every sample interval it sums the CPU time of
the job's process tree (descendants of the child plus its process group). It kills the
job when the tree gains too little CPU over a trailing window with no new processes appearing (idle) or when the job
runs past a wall-clock cap. Exit 124 on a kill; 143 when killed from heavy-top.

Env (minutes may be fractional; 0 disables the check):
  HEAVY_IDLE_MIN   idle window in minutes, default 10
  HEAVY_IDLE_CPU   CPU-seconds the tree must gain per window, default 5
  HEAVY_MAX_MIN    wall cap in minutes, default 90
  HEAVY_SAMPLE_SEC sample interval in seconds, default 30 (test/tuning only)

Stdlib only, Python 3.10+.
"""
from __future__ import annotations

import sys

# Keep everything above this guard parseable by old Pythons (macOS /usr/bin/python3 is 3.9).
# Too old? Re-exec under a newer python3 (so `ssh host heavy` works with a bare PATH).
# Candidates: $HEAVY_PYTHON, python3.20..python3.10 on PATH, then well-known absolute paths.
# $HEAVY_PYTHON_CANDIDATES (os.pathsep-separated) replaces the last two groups; test seam.
def _reexec_or_exit():
    import os
    import shutil
    import subprocess
    here = os.path.realpath(sys.executable or "")
    if not os.environ.get("HEAVY_REEXEC"):
        override = os.environ.get("HEAVY_PYTHON_CANDIDATES")
        if override is not None:
            cands = [c for c in override.split(os.pathsep) if c]
        else:
            cands = [shutil.which("python3.%d" % n) for n in range(20, 9, -1)] + [
                "/opt/homebrew/bin/python3", "/usr/local/bin/python3",
                "/home/linuxbrew/.linuxbrew/bin/python3", "/usr/bin/python3"]
        cands = [os.environ.get("HEAVY_PYTHON")] + cands
        for cand in cands:
            if not cand or not os.access(cand, os.X_OK) or os.path.realpath(cand) == here:
                continue
            try:
                ok = subprocess.run(
                    [cand, "-c", "import sys; print(sys.version_info[:2] >= (3,10))"],
                    stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=5,
                    universal_newlines=True).stdout.strip() == "True"
            except (OSError, subprocess.SubprocessError):
                continue
            if ok:
                os.environ["HEAVY_REEXEC"] = "1"
                os.execv(cand, [cand, os.path.realpath(__file__)] + sys.argv[1:])
    sys.stderr.write("heavy: needs python3 >= 3.10 (found %d.%d at %s)"
                     " — set HEAVY_PYTHON to a python3 >= 3.10\n"
                     % (sys.version_info[0], sys.version_info[1], sys.executable))
    sys.exit(2)


if sys.version_info < (3, 10):
    _reexec_or_exit()
else:
    # Version is fine: drop the loop-guard marker so nested heavy invocations in the job can re-exec.
    import os as _os
    _os.environ.pop("HEAVY_REEXEC", None)

import math
import os
import shlex
import signal
import subprocess
import time
from collections import deque
from dataclasses import dataclass
from typing import Callable, Mapping, Optional

sys.dont_write_bytecode = True  # no __pycache__ next to the installed scripts
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import heavyq  # noqa: E402

KILL_EXIT = 124
TICK_SEC = 0.5  # supervise wait granularity: how fast a heavy-top kill flag is seen
REMOTE_KILL_EXIT = 143
REMOTE_KILL_MSG = "heavy: killed from heavy-top"
TERM_GRACE_SEC = 10.0
FORWARDED_SIGNALS = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP)
WAIT_SIGNALS = FORWARDED_SIGNALS
CANCEL_EXIT = 125
CANCEL_MSG = "heavy: cancelled from heavy-top"
HOME_ERROR_EXIT = 2


# --- parsing ---------------------------------------------------------------

@dataclass(frozen=True)
class Proc:
    pid: int
    ppid: int
    pgid: int
    cpu: float


def parse_cpu_time(s: str) -> Optional[float]:
    """Parse ps TIME: [[dd-]hh:]mm:ss[.cc] -> seconds, or None if malformed."""
    try:
        days = 0
        if "-" in s:
            d, s = s.split("-", 1)
            days = int(d)
        parts = s.split(":")
        if not 2 <= len(parts) <= 3:
            return None
        secs = float(parts[-1])
        for unit, p in zip((60, 3600), reversed(parts[:-1])):
            secs += int(p) * unit
        return days * 86400 + secs
    except ValueError:
        return None


def parse_ps(text: str) -> list[Proc]:
    """Parse `ps -axo pid=,ppid=,pgid=,time=` output, skipping malformed rows."""
    procs = []
    for line in text.splitlines():
        f = line.split()
        if len(f) != 4:
            continue
        cpu = parse_cpu_time(f[3])
        try:
            pid, ppid, pgid = int(f[0]), int(f[1]), int(f[2])
        except ValueError:
            continue
        if cpu is not None:
            procs.append(Proc(pid, ppid, pgid, cpu))
    return procs


def select_tree(procs: list[Proc], root: int, pgid: int) -> dict[int, float]:
    """pid -> cpu for descendants of root (by ppid) plus every member of group pgid."""
    children: dict[int, list[int]] = {}
    for p in procs:
        children.setdefault(p.ppid, []).append(p.pid)
    tree = {root}
    stack = [root]
    while stack:
        for c in children.get(stack.pop(), ()):
            if c not in tree:
                tree.add(c)
                stack.append(c)
    tree.update(p.pid for p in procs if p.pgid == pgid)
    return {p.pid: p.cpu for p in procs if p.pid in tree}


# --- config ----------------------------------------------------------------

@dataclass(frozen=True)
class Config:
    idle_cpu: float
    idle_min: float
    max_min: float
    sample_sec: float


def _env_number(env: Mapping[str, str], name: str, default: float, warn: Callable[[str], None],
                allow_zero: bool = True) -> float:
    raw = env.get(name)
    if raw is None:
        return default
    try:
        v = float(raw)
        if not math.isfinite(v) or v < 0 or (v == 0 and not allow_zero):
            raise ValueError
    except ValueError:
        warn(f"heavy: invalid {name}={raw!r}; using default {default:g}")
        return default
    return v


def load_config(env: Mapping[str, str], warn: Callable[[str], None]) -> Config:
    return Config(
        idle_cpu=_env_number(env, "HEAVY_IDLE_CPU", 5.0, warn),
        idle_min=_env_number(env, "HEAVY_IDLE_MIN", 10.0, warn),
        max_min=_env_number(env, "HEAVY_MAX_MIN", 90.0, warn),
        sample_sec=_env_number(env, "HEAVY_SAMPLE_SEC", 30.0, warn, allow_zero=False),
    )


# --- decision logic --------------------------------------------------------

@dataclass(frozen=True)
class Decision:
    kind: str  # "continue" | "idle" | "wallcap"
    cpu: float = 0.0  # CPU gained over the window (idle only)


class Watchdog:
    """Pure decision logic: feed (timestamp, per-pid cpu) samples, get a Decision."""

    def __init__(self, idle_cpu: float, idle_sec: float, max_sec: float, start: float):
        self._idle_cpu, self._idle_sec, self._max_sec, self._start = idle_cpu, idle_sec, max_sec, start
        self._high: dict[int, float] = {}
        self._history: deque[tuple[float, float]] = deque([(start, 0.0)])
        # Process churn counts as activity: ps TIME never includes exited children, so a
        # loop of short-lived processes looks CPU-idle. The first sample's pids count as
        # present since start; any pid first seen later is a "join" at that time.
        self._seen: Optional[set[int]] = None
        self._last_join = start
        # Last sample that showed progress: a join, or a CPU gain at the rate the idle
        # check requires (any gain when idle checks are off). Shown by heavy-top.
        self.last_progress = start
        self._prev = (start, 0.0)

    def _note_gain(self, now: float, total: float) -> None:
        prev_t, prev_total = self._prev
        self._prev = (now, total)
        gain = total - prev_total
        if self._idle_sec <= 0 or self._idle_cpu <= 0:
            progressed = gain > 0
        else:
            progressed = gain >= self._idle_cpu * (now - prev_t) / self._idle_sec
        if progressed:
            self.last_progress = now

    def observe(self, now: float, samples: Optional[Mapping[int, float]]) -> Decision:
        """samples=None means the sample failed: only the wall cap is judged."""
        if self._max_sec > 0 and now - self._start > self._max_sec:
            return Decision("wallcap")
        if samples is None:
            return Decision("continue")
        if self._seen is None:
            self._seen = set(samples)
        elif not self._seen.issuperset(samples):
            self._seen.update(samples)
            self._last_join = now
            self.last_progress = now
        for pid, cpu in samples.items():
            self._high[pid] = max(self._high.get(pid, 0.0), cpu)
        total = sum(self._high.values())
        self._history.append((now, total))
        self._note_gain(now, total)
        if self._idle_sec <= 0 or now - self._start < self._idle_sec:
            return Decision("continue")
        cutoff = now - self._idle_sec
        while len(self._history) > 1 and self._history[1][0] <= cutoff:
            self._history.popleft()
        gain = total - self._history[0][1]
        if gain < self._idle_cpu and self._last_join <= cutoff:
            return Decision("idle", cpu=gain)
        return Decision("continue")


def kill_message(d: Decision, cfg: Config) -> str:
    if d.kind == "wallcap":
        return (f"heavy: killed job at wall cap (HEAVY_MAX_MIN={cfg.max_min:g}m)"
                " — override per call: HEAVY_MAX_MIN=0 heavy <cmd>")
    return (f"heavy: killed idle job ({d.cpu:.1f}s CPU in last {cfg.idle_min:g}m; "
            f"limit HEAVY_IDLE_CPU={cfg.idle_cpu:g}s/HEAVY_IDLE_MIN={cfg.idle_min:g}m)"
            " — override per call: HEAVY_IDLE_MIN=0 heavy <cmd>")


# --- I/O loop --------------------------------------------------------------

def supervise(cfg: Config, *, clock: Callable[[], float], wait_exit: Callable[[float], Optional[int]],
              sampler: Callable[[], Optional[Mapping[int, float]]], kill: Callable[[], None],
              kill_requested: Callable[[], bool] = lambda: False,
              on_progress: Callable[[float], None] = lambda t: None,
              tick: float = TICK_SEC):
    """Poll until the child exits, heavy-top asks for a kill, or the watchdog fires.

    wait_exit(sec) blocks up to sec and returns the child's exit code, or None if still
    running. It is called in ticks of at most `tick`, so a kill flag is seen promptly;
    the tree is sampled every cfg.sample_sec. Returns ("exit", code), or ("remote", msg)
    / ("killed", msg) after calling kill().
    """
    start = clock()
    dog = Watchdog(cfg.idle_cpu, cfg.idle_min * 60, cfg.max_min * 60, start)
    next_sample = start + cfg.sample_sec
    while True:
        code = wait_exit(max(0.0, min(tick, next_sample - clock())))
        if code is not None:
            return "exit", code
        if kill_requested():
            sampler()  # refresh the tracked pids so kill() reaches processes that left the pgrp
            kill()
            return "remote", REMOTE_KILL_MSG
        now = clock()
        if now < next_sample:
            continue
        next_sample += cfg.sample_sec
        if next_sample <= now:  # a slow sample: don't fire a burst to catch up
            next_sample = now + cfg.sample_sec
        d = dog.observe(now, sampler())
        on_progress(dog.last_progress)
        if d.kind != "continue":
            kill()
            return "killed", kill_message(d, cfg)


# --- real process plumbing -------------------------------------------------

def ps_sampler(root: int, pgid: int, run=subprocess.run) -> Callable[[], Optional[dict[int, float]]]:
    last: dict[int, float] = {}

    def sample() -> Optional[dict[int, float]]:
        try:
            r = run(["ps", "-axo", "pid=,ppid=,pgid=,time="], capture_output=True, text=True, timeout=20)
        except (OSError, subprocess.SubprocessError):
            return None
        if r.returncode != 0:
            return None
        tree = select_tree(parse_ps(r.stdout), root, pgid)
        last.clear()
        last.update(tree)
        return tree

    sample.last_pids = last  # type: ignore[attr-defined]
    return sample


def _signal_all(sig: int, pgid: int, pids) -> None:
    try:
        os.killpg(pgid, sig)
    except OSError:
        pass
    for pid in pids:
        try:
            os.kill(pid, sig)
        except OSError:
            pass


def kill_tree(proc: subprocess.Popen, pgid: int, pids, grace: float = TERM_GRACE_SEC) -> None:
    """SIGTERM the group and tracked pids; SIGKILL whatever survives the grace period."""
    pids = [p for p in pids if p != os.getpid()]
    _signal_all(signal.SIGTERM, pgid, pids)
    try:
        proc.wait(timeout=grace)
    except subprocess.TimeoutExpired:
        pass
    _signal_all(signal.SIGKILL, pgid, pids)  # group may hold stragglers even if the child exited
    try:
        proc.wait(timeout=5)
    except subprocess.TimeoutExpired:
        pass


def exit_code(returncode: int) -> int:
    return 128 - returncode if returncode < 0 else returncode


# --- queue ------------------------------------------------------------------

class SignalLatch:
    """While waiting, a signal is only recorded; the wait loop leaves the queue and exits."""

    def __init__(self, signals=WAIT_SIGNALS):
        self._signals = signals
        self._sig: Optional[int] = None

    def install(self) -> None:
        for sig in self._signals:
            signal.signal(sig, self._record)

    def _record(self, signum, _frame) -> None:
        if self._sig is None:
            self._sig = signum

    def pending(self) -> Optional[int]:
        return self._sig


def wait_for_slot(store: heavyq.Store, me: heavyq.Waiter, *, clock: Callable[[], float],
                  sleep: Callable[[float], None], pending: Callable[[], Optional[int]],
                  tick: float = TICK_SEC) -> heavyq.Admitted | heavyq.Cancelled | int:
    """Poll for admission every tick. Returns Admitted, Cancelled, or a signal number."""
    while True:
        sig = pending()
        if sig:
            heavyq.leave_queue(store, me.pid)
            return sig
        step = heavyq.admit_step(store, me, clock())
        if not isinstance(step, heavyq.Waiting):
            return step
        sleep(tick)


def _waiter_for(argv: list[str], clock: Callable[[], float]) -> heavyq.Waiter:
    try:
        cwd = os.getcwd()
    except OSError:
        cwd = ""
    now = clock()
    return heavyq.Waiter(pid=os.getpid(), cmd=shlex.join(argv), cwd=cwd, enqueued=now, order=now)


# --- main ------------------------------------------------------------------

def _run_admitted(argv, cfg, store, holder, latch, *, spawn, clock, mono, killer) -> int:
    try:
        proc = spawn(argv, preexec_fn=os.setpgrp)
    except OSError as e:
        print(f"heavy-run: {argv[0]}: {e.strerror}", file=sys.stderr)
        return 127 if isinstance(e, FileNotFoundError) else 126
    pgid = proc.pid
    for sig in FORWARDED_SIGNALS:
        signal.signal(sig, lambda s, _f: _signal_all(s, pgid, ()))
    late = latch.pending()  # arrived between the post-admission check and the handlers
    if late:
        _signal_all(late, pgid, ())

    def wait_exit(sec: float) -> Optional[int]:
        try:
            return proc.wait(timeout=sec)
        except subprocess.TimeoutExpired:
            return None

    def on_progress(t_mono: float) -> None:
        try:
            heavyq.record_progress(store, holder, clock() - (mono() - t_mono))
        except OSError:
            pass  # display only

    sampler = ps_sampler(proc.pid, pgid)
    kind, value = supervise(
        cfg, clock=mono, wait_exit=wait_exit, sampler=sampler,
        kill=lambda: killer(proc, pgid, list(sampler.last_pids)),
        kill_requested=lambda: heavyq.kill_requested(store, holder.pid),
        on_progress=on_progress,
    )
    if kind == "remote":
        print(value, file=sys.stderr)
        return REMOTE_KILL_EXIT
    if kind == "killed":
        print(value, file=sys.stderr)
        return KILL_EXIT
    return exit_code(value)


def _queue_and_run(argv, cfg, store, *, spawn, clock, mono, sleep, killer) -> int:
    latch = SignalLatch()
    latch.install()
    me = _waiter_for(argv, clock)
    try:
        heavyq.enqueue(store, me)
    except heavyq.Busy:
        pass  # admit_step re-creates the entry on its first poll
    got = wait_for_slot(store, me, clock=clock, sleep=sleep, pending=latch.pending)
    if isinstance(got, int):
        return 128 + got
    if isinstance(got, heavyq.Cancelled):
        print(CANCEL_MSG, file=sys.stderr)
        return CANCEL_EXIT
    try:
        sig = latch.pending()
        if sig:
            return 128 + sig
        return _run_admitted(argv, cfg, store, got.holder, latch,
                             spawn=spawn, clock=clock, mono=mono, killer=killer)
    finally:
        heavyq.finish(store, me.pid)
        if got.slot_fd is not None:
            os.close(got.slot_fd)


def main(argv: list[str], env: Mapping[str, str] = os.environ, *, spawn=subprocess.Popen,
         clock: Callable[[], float] = time.time, mono: Callable[[], float] = time.monotonic,
         sleep: Callable[[float], None] = time.sleep, killer=None) -> int:
    if not argv:
        print("usage: heavy-run <cmd> [args...]", file=sys.stderr)
        return 2
    warn = lambda m: print(m, file=sys.stderr)
    cfg = load_config(env, warn)
    paths = heavyq.Paths.from_env(env)
    store = heavyq.Store(paths)
    try:
        store.ensure()
        live_fd = store.hold_live(os.getpid())
    except OSError as e:
        print(f"heavy: cannot use HEAVY_HOME {paths.home}: {e.strerror or e}", file=sys.stderr)
        return HOME_ERROR_EXIT
    try:
        return _queue_and_run(argv, cfg, store, spawn=spawn, clock=clock, mono=mono, sleep=sleep,
                              killer=killer or kill_tree)
    finally:
        os.close(live_fd)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
