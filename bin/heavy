#!/bin/sh
# heavy: run a CPU-heavy command through a machine-wide queue.
# Every caller on this host shares one queue in $HEAVY_HOME (default ~/.heavy), so at most
# N heavy commands run at once (N = slots); others wait in strict FIFO order (heavy-top can
# bump, force or cancel a waiter). Output, stdin and exit code pass through unchanged.
#
# Usage: heavy <cmd> [args...]
# Status: heavy --status   (lists running holders)
# TUI:    heavy --top      (live view and job control; see heavy-top)
# Slots:  ~/.config/heavy/slots (one integer), default 2. Read on every admission check.
#
# Exit codes: the command's own, or 124 (watchdog kill), 125 (cancelled from heavy-top
# while waiting), 143 (killed from heavy-top), 130/143/129 (INT/TERM/HUP while waiting),
# 2 (HEAVY_HOME unusable; the command never runs).
#
# Watchdog: once a job is admitted, heavy-run kills it (exit 124) if its process tree
# gains < HEAVY_IDLE_CPU CPU-seconds (default 5) over HEAVY_IDLE_MIN minutes (default 10),
# or if it runs past HEAVY_MAX_MIN minutes (default 90). 0 disables a check.
# Per call: HEAVY_IDLE_MIN=0 heavy <cmd>

set -eu

SLOTS_FILE="${HOME}/.config/heavy/slots"
HEAVY_HOME="${HEAVY_HOME:-$HOME/.heavy}"
here="$(dirname "$(readlink -f "$0")")"

if [ "${1:-}" = "--top" ]; then
  shift
  exec "$here/heavy-top" "$@"
fi

if [ "${1:-}" = "--status" ]; then
  slots=2
  if [ -r "$SLOTS_FILE" ]; then
    s=$(tr -dc '0-9' < "$SLOTS_FILE")
    [ -n "$s" ] && [ "$s" -gt 0 ] && slots=$s
  fi
  echo "slots: $slots"
  for f in "$HEAVY_HOME"/running/[0-9]*.json; do
    [ -e "$f" ] || continue
    pid=${f##*/}; pid=${pid%.json}
    ps -o pid=,etime=,command= -p "$pid" 2>/dev/null | cut -c1-160 || true
  done
  exit 0
fi

[ $# -gt 0 ] || { echo "usage: heavy <cmd> [args...] | heavy --status | heavy --top" >&2; exit 2; }

exec "$here/heavy-run" "$@"
