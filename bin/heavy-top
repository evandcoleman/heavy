#!/usr/bin/env python3
"""heavy-top: live TUI for the machine-wide `heavy` queue.

Shows slot usage, running jobs (with CPU of their whole process tree), the waiting
queue in order, and host load. Reads $HEAVY_HOME (see heavyq.py). Stdlib only.

Usage: heavy-top [--once] [--interval SECONDS]
Keys:  q quit · r refresh now · [/] change refresh interval
"""
from __future__ import annotations

import sys

# Keep everything above this guard parseable by old Pythons (macOS /usr/bin/python3 is 3.9).
if sys.version_info < (3, 10):
    sys.stderr.write("heavy: needs python3 >= 3.10 (found %d.%d at %s)\n"
                     % (sys.version_info[0], sys.version_info[1], sys.executable))
    sys.exit(2)

import argparse
import os
import re
import select
import shutil
import signal
import subprocess
import termios
import time
import tty
from collections import deque
from dataclasses import dataclass
from pathlib import Path
from typing import Callable, Literal

sys.dont_write_bytecode = True  # no __pycache__ next to the installed scripts
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import heavyq  # noqa: E402

HOME = str(Path.home())
IDLE_HINT_SEC = 60
HOME_ERROR_EXIT = 2

# ── data ──────────────────────────────────────────────────────────────────


@dataclass(frozen=True)
class Proc:
    pid: int
    ppid: int
    cpu: float
    elapsed: int
    command: str


@dataclass(frozen=True)
class Row:
    kind: Literal["run", "wait"]
    pid: int
    token: float  # started (run) or enqueued (wait): identifies this incarnation of pid
    cmd: str
    cwd: str
    elapsed: int
    cpu: float
    tags: tuple[str, ...]
    rank: int | None  # 1-based queue position; None for running or pending force/cancel


@dataclass(frozen=True)
class Snapshot:
    slots: int
    held: int
    forced: int
    paused: bool
    running: tuple[Row, ...]
    waiting: tuple[Row, ...]
    load: tuple[float, float, float]
    cores: int

    def rows(self) -> tuple[Row, ...]:
        """Selection order: running, then waiting."""
        return self.running + self.waiting


EMPTY_STATE = heavyq.QueueState(waiters=(), holders=(), n=heavyq.DEFAULT_SLOTS, held=frozenset(),
                                paused=False, corrupt=())


def parse_etime(s: str) -> int:
    """ps etime: [[dd-]hh:]mm:ss → seconds."""
    days = 0
    if "-" in s:
        d, s = s.split("-", 1)
        days = int(d)
    parts = [int(p) for p in s.split(":")]
    while len(parts) < 3:
        parts.insert(0, 0)
    h, m, sec = parts
    return days * 86400 + h * 3600 + m * 60 + sec


def parse_ps(text: str) -> dict[int, Proc]:
    procs: dict[int, Proc] = {}
    for line in text.splitlines():
        f = line.split(None, 4)
        if len(f) < 5:
            continue
        try:
            p = Proc(int(f[0]), int(f[1]), float(f[2]), parse_etime(f[3]), f[4])
        except ValueError:
            continue
        procs[p.pid] = p
    return procs


def tree_cpu(root: int, procs: dict[int, Proc]) -> float:
    children: dict[int, list[int]] = {}
    for p in procs.values():
        children.setdefault(p.ppid, []).append(p.pid)
    total, stack, seen = 0.0, [root], set()
    while stack:
        pid = stack.pop()
        if pid in seen or pid not in procs:
            continue
        seen.add(pid)
        total += procs[pid].cpu
        stack.extend(children.get(pid, []))
    return total


def fmt_idle(sec: float) -> str:
    m = int(sec // 60)
    return f"{m}m" if m < 60 else f"{m // 60}h{m % 60:02d}m"


def _since(now: float, t: float) -> int:
    return max(0, int(now - t))  # clamp: an NTP step back must not show negative time


def _run_row(h: heavyq.Holder, procs: dict[int, Proc], now: float) -> Row:
    tags = []
    if h.forced:
        tags.append("forced")
    if h.kill:
        tags.append("killing")
    if h.last_progress is not None and now - h.last_progress >= IDLE_HINT_SEC:
        tags.append(f"idle {fmt_idle(now - h.last_progress)}")
    return Row("run", h.pid, h.started, h.cmd, h.cwd, _since(now, h.started),
               tree_cpu(h.pid, procs), tuple(tags), None)


def _wait_row(w: heavyq.Waiter, rank: int | None, now: float) -> Row:
    tags = []
    if w.cancel:
        tags.append("cancelling")
    elif w.force:
        tags.append("forcing")
    elif w.order < w.enqueued:
        tags.append("bumped")
    return Row("wait", w.pid, w.enqueued, w.cmd, w.cwd, _since(now, w.enqueued), 0.0,
               tuple(tags), rank)


def build_snapshot(state: heavyq.QueueState, procs: dict[int, Proc],
                   load: tuple[float, float, float], cores: int, now: float) -> Snapshot:
    running = tuple(_run_row(h, procs, now) for h in state.holders)
    waiting, rank = [], 0
    for w in state.waiters:  # ranked first, pending force/cancel after (heavyq.read_state)
        pending = w.force or w.cancel
        if not pending:
            rank += 1
        waiting.append(_wait_row(w, None if pending else rank, now))
    return Snapshot(slots=state.n, held=len(state.held), forced=sum(h.forced for h in state.holders),
                    paused=state.paused, running=running, waiting=tuple(waiting),
                    load=load, cores=cores)


# ── system probes (side effects) ─────────────────────────────────────────


def ps_procs() -> dict[int, Proc]:
    try:
        out = subprocess.run(["ps", "-axo", "pid=,ppid=,pcpu=,etime=,command="],
                             capture_output=True, text=True, timeout=10,
                             env={**os.environ, "LC_ALL": "C"}).stdout
    except (OSError, subprocess.SubprocessError):
        return {}
    return parse_ps(out)


def probe(store: heavyq.Store, now: float, prev: Snapshot | None = None,
          ps: Callable[[], dict[int, Proc]] = ps_procs,
          read: Callable[[heavyq.Store], heavyq.QueueState] = heavyq.read_state,
          ) -> tuple[Snapshot, tuple[str, ...]]:
    """Read the queue under its lock, then ps outside it. Busy -> previous snapshot + note."""
    load, cores = os.getloadavg(), os.cpu_count() or 1
    try:
        state = read(store)
    except heavyq.Busy:
        return (prev or build_snapshot(EMPTY_STATE, {}, load, cores, now)), ("queue busy",)
    notes = tuple(f"dropped corrupt entry {name}" for name in state.corrupt)
    return build_snapshot(state, ps(), load, cores, now), notes


# ── rendering ─────────────────────────────────────────────────────────────

RESET, BOLD, DIM, REVERSE = "\x1b[0m", "\x1b[1m", "\x1b[2m", "\x1b[7m"


def rgb(r, g, b):
    return f"\x1b[38;2;{r};{g};{b}m"


GREEN, YELLOW, RED = rgb(120, 220, 140), rgb(240, 200, 90), rgb(240, 100, 100)
CYAN, GREY, MAUVE = rgb(110, 200, 230), rgb(130, 130, 140), rgb(190, 150, 240)
SPARK = "▁▂▃▄▅▆▇█"
ANSI_RE = re.compile(r"\x1b\[[0-9;]*m")
KEYS_HELP = "↑↓ f force · x kill · c cancel · b bump · p pause · +/- slots"


def vlen(s: str) -> int:
    return len(ANSI_RE.sub("", s))


def clip(s: str, width: int) -> str:
    return s if len(s) <= width else s[: max(0, width - 1)] + "…"


def lclip(s: str, width: int) -> str:
    return s if len(s) <= width else "…" + s[len(s) - max(0, width - 1):]


def fmt_dur(sec: int) -> str:
    h, rem = divmod(sec, 3600)
    m, s = divmod(rem, 60)
    return f"{h}h{m:02d}m" if h else f"{m}m{s:02d}s"


def short_path(p: str) -> str:
    if p == HOME or p.startswith(HOME + "/"):
        p = "~" + p[len(HOME):]
    return p


def load_color(ratio: float) -> str:
    return GREEN if ratio < 0.7 else YELLOW if ratio < 1.5 else RED


def sparkline(values, top: float) -> str:
    out = []
    for v in values:
        idx = min(len(SPARK) - 1, int(v / top * (len(SPARK) - 1))) if top else 0
        out.append(load_color(v / top * 2 if top else 0) + SPARK[idx])
    return "".join(out) + RESET


def box(title: str, lines: list[str], width: int, color: str) -> list[str]:
    inner = width - 4
    head = f"{color}╭─ {BOLD}{title}{RESET}{color} " + "─" * max(0, width - vlen(title) - 5) + "╮" + RESET
    body = [f"{color}│{RESET} " + l + " " * max(0, inner - vlen(l)) + f" {color}│{RESET}" for l in lines]
    foot = f"{color}╰" + "─" * (width - 2) + "╯" + RESET
    return [head, *body, foot]


def _tag_text(r: Row) -> str:
    return "".join(f" [{t}]" for t in r.tags)


def _cmd_cell(r: Row, width: int) -> str:
    tags = _tag_text(r)
    return f"{BOLD}{clip(r.cmd, max(8, width - len(tags)))}{RESET}{MAUVE}{tags}{RESET}"


def _highlight(line: str, on: bool) -> str:
    return f"{REVERSE}{ANSI_RE.sub('', line)}{RESET}" if on else line


def _run_lines(snap: Snapshot, cmd_w: int, selected) -> list[str]:
    lines = []
    for i, r in enumerate(snap.running, 1):
        cpu_c = load_color(r.cpu / 100 / max(1, snap.cores / 2))
        first = (f"{MAUVE}{i}{RESET}  {r.pid:>6}  {CYAN}{fmt_dur(r.elapsed):>7}{RESET}"
                 f"  {cpu_c}{r.cpu:>5.0f}%{RESET}  {_cmd_cell(r, cmd_w)}")
        lines.append(_highlight(first, selected == ("run", r.pid)))
        if r.cwd:
            lines.append(f"{' ' * 28}{GREY}{lclip(short_path(r.cwd), cmd_w)}{RESET}")
    for i in range(max(0, snap.slots - snap.held)):
        lines.append(f"{GREY}{len(snap.running) + i + 1}  {'—':>6}  free{RESET}")
    return lines


def _wait_groups(snap: Snapshot, cmd_w: int, selected) -> list[list[str]]:
    groups = []
    for r in snap.waiting:
        rank = f"{r.rank:>2}" if r.rank is not None else " ·"
        first = (f"{YELLOW}{rank}{RESET} {r.pid:>6}  {YELLOW}{fmt_dur(r.elapsed):>7}{RESET}"
                 f"  {_cmd_cell(r, cmd_w)}")
        g = [_highlight(first, selected == ("wait", r.pid))]
        if r.cwd:
            g.append(f"{' ' * 20}{GREY}{lclip(short_path(r.cwd), cmd_w)}{RESET}")
        groups.append(g)
    return groups


def _fit_groups(groups: list[list[str]], budget: int | None) -> list[str]:
    lines: list[str] = []
    for n, g in enumerate(groups):
        room = None if budget is None else budget - len(lines) - (1 if n < len(groups) - 1 else 0)
        if room is not None and len(g) > room:
            lines.append(f"{GREY}+{len(groups) - n} more{RESET}")
            break
        lines.extend(g)
    return lines or [f"{GREY}nobody waiting{RESET}"]


def render(snap: Snapshot, history, width: int, interval: float, color=True,
           max_rows: int | None = None, selected: tuple[str, int] | None = None,
           footer: str | None = None) -> str:
    width = max(50, min(width, 160))
    inner = width - 4
    lc = load_color(snap.load[0] / snap.cores)

    pips = "".join((MAUVE + "●") if i < snap.held else (GREY + "○") for i in range(snap.slots)) + RESET
    forced = f" {MAUVE}+{snap.forced} forced{RESET}" if snap.forced else ""
    title = f"{BOLD}heavy{RESET} {GREY}queue{RESET}"
    stats = (f"{pips} {snap.held}/{snap.slots} slots{forced}   "
             f"{GREY}waiting{RESET} {BOLD}{len(snap.waiting)}{RESET}   "
             f"{GREY}load{RESET} {lc}{snap.load[0]:.1f}{RESET}"
             f"{GREY}/{snap.load[1]:.1f}/{snap.load[2]:.1f} on {snap.cores} cores{RESET}")
    clock = GREY + time.strftime("%H:%M:%S %Z") + RESET
    header = title + " " * max(1, width - vlen(title) - vlen(clock)) + clock
    banner = f"{RED}{BOLD}PAUSED{RESET} {GREY}— new jobs wait; forced jobs still start · p resumes{RESET}" \
        if snap.paused else ""

    hist = list(history)[-(inner - 8):]
    top = max([snap.cores * 2.0, *hist]) if hist else snap.cores * 2.0
    spark = f"{GREY}load {RESET}" + sparkline(hist, top)

    cmd_w = inner - 30
    run_lines = _run_lines(snap, cmd_w, selected)
    # fixed rows: 5 header + running box (3 + lines) + waiting box frame (3) + footer
    budget = None if max_rows is None else max(1, max_rows - (12 + len(run_lines)))
    wait_lines = _fit_groups(_wait_groups(snap, cmd_w, selected), budget)

    foot = footer if footer is not None else f"{KEYS_HELP} · [/] {interval:g}s · q quit"
    rows = [header, banner, stats, spark, "",
            *box("running", [f"{GREY}#     pid  elapsed     cpu  command{RESET}", *run_lines], width, MAUVE),
            *box("waiting", [f"{GREY} #    pid   waited  command{RESET}", *wait_lines], width, YELLOW),
            f"{GREY}{clip(foot, width)}{RESET}"]
    out = "\n".join(rows)
    return out if color else ANSI_RE.sub("", out)


# ── main loop ─────────────────────────────────────────────────────────────


ENTER_SCREEN, LEAVE_SCREEN = "\x1b[?1049h\x1b[?25l", "\x1b[?25h\x1b[?1049l"


def _exit_on_signal(*_):
    raise SystemExit(0)


def run_tui(store: heavyq.Store, interval: float) -> None:
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    history: deque[float] = deque(maxlen=400)
    resized = [True]
    snap: Snapshot | None = None

    def enter():
        tty.setcbreak(fd)
        sys.stdout.write(ENTER_SCREEN)
        sys.stdout.flush()

    def leave():
        termios.tcsetattr(fd, termios.TCSAFLUSH, old)
        sys.stdout.write(LEAVE_SCREEN)
        sys.stdout.flush()

    def on_tstp(*_):  # Ctrl-Z: restore the terminal before stopping
        leave()
        signal.signal(signal.SIGTSTP, signal.SIG_DFL)
        os.kill(os.getpid(), signal.SIGTSTP)

    def on_cont(*_):
        signal.signal(signal.SIGTSTP, on_tstp)
        enter()
        resized[0] = True

    signal.signal(signal.SIGWINCH, lambda *_: resized.__setitem__(0, True))
    signal.signal(signal.SIGTERM, _exit_on_signal)
    signal.signal(signal.SIGHUP, _exit_on_signal)
    signal.signal(signal.SIGTSTP, on_tstp)
    signal.signal(signal.SIGCONT, on_cont)
    try:
        enter()
        while True:
            snap, notes = probe(store, time.time(), snap)
            history.append(snap.load[0])
            size = shutil.get_terminal_size()
            frame = render(snap, history, size.columns, interval, max_rows=size.lines,
                           footer=notes[0] if notes else None)
            clear = "\x1b[2J" if resized[0] else ""
            resized[0] = False
            sys.stdout.write(clear + "\x1b[H" + frame.replace("\n", "\x1b[K\n") + "\x1b[K\x1b[J")
            sys.stdout.flush()
            deadline = time.monotonic() + interval
            while (left := deadline - time.monotonic()) > 0:
                r, _, _ = select.select([sys.stdin], [], [], left)
                if not r:
                    continue
                data = os.read(fd, 64)  # drain whole escape sequences (arrows, wheel)
                if not data:
                    return  # stdin closed
                if len(data) > 1 and data[0] == 0x1b:
                    continue  # ignore escape sequences
                ch = data[:1].decode(errors="ignore")
                if ch in {"q", "Q", "\x03"}:
                    return
                if ch == "]":
                    interval = min(30.0, interval + 1)
                elif ch == "[":
                    interval = max(1.0, interval - 1)
                elif ch != "r":
                    continue
                break
    except KeyboardInterrupt:
        pass
    finally:
        for sig in (signal.SIGTSTP, signal.SIGCONT, signal.SIGTERM, signal.SIGHUP):
            signal.signal(sig, signal.SIG_DFL)
        leave()


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="heavy-top", description=__doc__.splitlines()[0])
    ap.add_argument("--once", action="store_true", help="print one snapshot and exit")
    ap.add_argument("--interval", "-n", type=float, default=2.0, help="refresh seconds (default 2)")
    args = ap.parse_args(argv)
    paths = heavyq.Paths.from_env(os.environ)
    store = heavyq.Store(paths)
    try:
        store.ensure()
    except OSError as e:
        print(f"heavy: cannot use HEAVY_HOME {paths.home}: {e.strerror or e}", file=sys.stderr)
        return HOME_ERROR_EXIT
    if args.once or not sys.stdin.isatty() or not sys.stdout.isatty():
        snap, notes = probe(store, time.time())
        print(render(snap, [snap.load[0]], shutil.get_terminal_size().columns,
                     args.interval, color=sys.stdout.isatty(), footer=notes[0] if notes else None))
        return 0
    run_tui(store, max(1.0, args.interval))
    return 0


if __name__ == "__main__":
    sys.exit(main())
